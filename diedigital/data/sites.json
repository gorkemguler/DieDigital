{
  "_note": "method: status (404 = yok), absent_text (metin varsa yok), present_text (metin varsa var), json_null, json_empty, manual (otomatik kontrol güvenilmez, elle bak). {u} kullanıcı adıyla değiştirilir.",
  "sites": [
    {"name": "GitHub", "url": "https://github.com/{u}", "method": "status"},
    {"name": "GitLab", "url": "https://gitlab.com/{u}", "check": "https://gitlab.com/api/v4/users?username={u}", "method": "json_empty"},
    {"name": "Reddit", "url": "https://www.reddit.com/user/{u}", "check": "https://www.reddit.com/user/{u}/about.json", "method": "status"},
    {"name": "Hacker News", "url": "https://news.ycombinator.com/user?id={u}", "check": "https://hacker-news.firebaseio.com/v0/user/{u}.json", "method": "json_null"},
    {"name": "Keybase", "url": "https://keybase.io/{u}", "check": "https://keybase.io/_/api/1.0/user/lookup.json?usernames={u}", "method": "absent_text", "text": "\"them\":[null]"},
    {"name": "Docker Hub", "url": "https://hub.docker.com/u/{u}", "check": "https://hub.docker.com/v2/users/{u}/", "method": "status"},
    {"name": "npm (paket sahibi)", "url": "https://www.npmjs.com/~{u}", "check": "https://registry.npmjs.org/-/v1/search?text=maintainer:{u}&size=1", "method": "absent_text", "text": "\"total\":0"},
    {"name": "PyPI", "url": "https://pypi.org/user/{u}/", "method": "status"},
    {"name": "DEV", "url": "https://dev.to/{u}", "check": "https://dev.to/api/users/by_username?url={u}", "method": "status"},
    {"name": "Mastodon (mastodon.social)", "url": "https://mastodon.social/@{u}", "check": "https://mastodon.social/api/v1/accounts/lookup?acct={u}", "method": "status"},
    {"name": "Lichess", "url": "https://lichess.org/@/{u}", "check": "https://lichess.org/api/user/{u}", "method": "status"},
    {"name": "Chess.com", "url": "https://www.chess.com/member/{u}", "check": "https://api.chess.com/pub/player/{u}", "method": "status"},
    {"name": "Codeforces", "url": "https://codeforces.com/profile/{u}", "check": "https://codeforces.com/api/user.info?handles={u}", "method": "absent_text", "text": "\"status\":\"FAILED\""},
    {"name": "Duolingo", "url": "https://www.duolingo.com/profile/{u}", "check": "https://www.duolingo.com/2017-06-30/users?username={u}", "method": "absent_text", "text": "\"users\":[]"},
    {"name": "Telegram", "url": "https://t.me/{u}", "method": "present_text", "text": "tgme_page_title"},
    {"name": "Steam", "url": "https://steamcommunity.com/id/{u}", "method": "absent_text", "text": "The specified profile could not be found"},
    {"name": "YouTube", "url": "https://www.youtube.com/@{u}", "method": "status"},
    {"name": "SoundCloud", "url": "https://soundcloud.com/{u}", "method": "status"},
    {"name": "Vimeo", "url": "https://vimeo.com/{u}", "method": "status"},
    {"name": "Linktree", "url": "https://linktr.ee/{u}", "method": "status"},
    {"name": "Instagram", "url": "https://www.instagram.com/{u}/", "method": "manual"},
    {"name": "Facebook", "url": "https://www.facebook.com/{u}", "method": "manual"},
    {"name": "X (Twitter)", "url": "https://x.com/{u}", "method": "manual"},
    {"name": "TikTok", "url": "https://www.tiktok.com/@{u}", "method": "manual"},
    {"name": "Threads", "url": "https://www.threads.net/@{u}", "method": "manual"},
    {"name": "Pinterest", "url": "https://www.pinterest.com/{u}/", "method": "manual"},
    {"name": "Twitch", "url": "https://www.twitch.tv/{u}", "method": "manual"},
    {"name": "Medium", "url": "https://medium.com/@{u}", "method": "manual"},
    {"name": "Behance", "url": "https://www.behance.net/{u}", "method": "manual"},
    {"name": "Ekşi Sözlük", "url": "https://eksisozluk.com/biri/{u}", "method": "manual"},
    {"name": "Spotify", "url": "https://open.spotify.com/user/{u}", "method": "manual"}
  ]
